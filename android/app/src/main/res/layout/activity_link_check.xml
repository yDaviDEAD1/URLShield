<?xml version="1.0" encoding="utf-8"?>
<!-- Pop-up compacto: sobe por cima do app de origem e cresce conforme a gravidade.
     A conversa continua visível atrás para a pessoa não perder o contexto. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:importantForAccessibility="no">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/sheet_background"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:orientation="vertical">

        <!-- wrap_content + peso: cresce com o conteúdo e só rola quando não cabe
             (ex.: fonte do sistema em 200%) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Carregando -->
                <LinearLayout
                    android:id="@+id/loadingBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="28dp">

                    <ProgressBar
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:indeterminateTint="@color/ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/checking_title"
                            android:textSize="24sp" />

                        <TextView
                            style="@style/Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/checking_description"
                            android:textColor="@color/ink_2"
                            android:textSize="17sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Veredito: ícone ao lado do título -->
                <LinearLayout
                    android:id="@+id/verdictBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="20dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/verdictTile"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/tile_background">

                            <ImageView
                                android:id="@+id/verdictIcon"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/verdictTitle"
                            style="@style/Text.Display"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:textSize="28sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/verdictSubtitle"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/verdictDomain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/chip_background"
                        android:ellipsize="middle"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Motivos: só o principal à mostra; o resto a um toque -->
                <LinearLayout
                    android:id="@+id/bodyBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="22dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/reasonsLabel"
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/label_why" />

                    <LinearLayout
                        android:id="@+id/reasonsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/moreReasonsButton"
                        style="@style/Button.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:paddingStart="0dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/ink_2"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Ações: sempre visíveis, na zona do polegar -->
        <LinearLayout
            android:id="@+id/actionsBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="14dp"
            android:paddingEnd="22dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <Button
                android:id="@+id/primaryButton"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/familyButton"
                    style="@style/Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_family"
                    android:minHeight="52dp"
                    android:text="@string/ask_family"
                    android:textSize="17sp" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/listenButton"
                    style="@style/Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_speaker"
                    android:minHeight="52dp"
                    android:text="@string/listen"
                    android:textSize="17sp" />
            </LinearLayout>

            <Button
                android:id="@+id/continueButton"
                style="@style/Button.Link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/continue_anyway"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/offlineNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="4dp"
                android:text="@string/offline_note"
                android:textColor="@color/ink_3"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
