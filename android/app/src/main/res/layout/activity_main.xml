<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de configuração: o dia a dia acontece no pop-up (LinkCheckActivity) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <TextView
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/app_name"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- Estado da proteção -->
        <LinearLayout
            android:id="@+id/statusBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:id="@+id/statusTile"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/tile_background">

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/statusTitle"
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:accessibilityHeading="true"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/statusDescription"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/ink_2" />

            <Button
                android:id="@+id/activateButton"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:minHeight="66dp"
                android:text="@string/activate_protection" />
        </LinearLayout>

        <!-- Navegador usado para abrir os sites aprovados -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browser_label" />

                <TextView
                    android:id="@+id/browserName"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/browserChangeButton"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="@string/browser_change" />
        </LinearLayout>

        <!-- Testar um link sem precisar de outra conversa -->
        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/test_label" />

        <EditText
            android:id="@+id/testUrlInput"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:autofillHints=""
            android:background="@drawable/input_background"
            android:hint="@string/test_link_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_3"
            android:textSize="19sp" />

        <Button
            android:id="@+id/testButton"
            style="@style/Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="62dp"
            android:text="@string/analyze_link"
            android:textSize="19sp" />

        <Button
            android:id="@+id/deactivateButton"
            style="@style/Button.Link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/deactivate_protection"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
